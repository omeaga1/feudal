{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Feudal",
  "version": "0.4.0",
  "identifier": "app.feudal.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Feudal",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Feudal",
    "category": "Game",
    "shortDescription": "Free Age of Empires IV companion",
    "longDescription": "Automatic matchup briefs, danger windows, map notes and a keybind reference for Age of Empires IV. Not endorsed by or affiliated with Microsoft.",
    "copyright": "Feudal is free software. Age of Empires IV \u00a9 Microsoft Corporation.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
